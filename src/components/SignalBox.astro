---
---
<div class="signal-mailer" data-signal-stage>
  <div class="signal-mailer__steps" aria-live="polite">
    <span class="is-active" data-step="1"><b>01</b> WRITE</span>
    <span data-step="2"><b>02</b> WRAP</span>
    <span data-step="3"><b>03</b> POST</span>
  </div>

  <div class="signal-mailer__grid">
    <form class="signal-letter" name="boomley-signal" method="POST" data-netlify="true" netlify-honeypot="bot-field" data-signal-form>
      <input type="hidden" name="form-name" value="boomley-signal" />
      <p class="honeypot"><label>Do not fill this out: <input name="bot-field" /></label></p>

      <div class="signal-letter__meta">
        <span>BOOMLEY SIGNAL FORM / 001</span>
        <span>THE BOX IS OPEN</span>
      </div>

      <h3>WHAT'S<br />BOTHERING YOU?</h3>
      <p class="signal-letter__intro">Don't pitch us an app. Tell us what should not still be this difficult.</p>

      <label>
        THE PROBLEM
        <textarea name="friction" rows="4" required placeholder="It shouldn't still be this difficult to..."></textarea>
      </label>

      <div class="signal-letter__split">
        <label>
          WHO DEALS WITH THIS?
          <input name="who" type="text" required placeholder="People who..." />
        </label>
        <label>
          YOUR EMAIL
          <input name="email" type="email" required autocomplete="email" placeholder="you@example.com" />
        </label>
      </div>

      <label>
        WHAT CHANGES IF SOMEONE FIXES IT?
        <textarea name="change" rows="2" required placeholder="It becomes easier to..."></textarea>
      </label>

      <div class="signal-letter__actions">
        <button class="mail-button mail-button--blue" type="button" data-wrap-button>WRAP IT <span>→</span></button>
        <button class="mail-button mail-button--red" type="submit" data-post-button disabled>POST IT <span>→</span></button>
      </div>

      <p class="form-status" data-signal-status aria-live="polite"></p>
    </form>

    <div class="signal-object" aria-hidden="true">
      <div class="signal-object__envelope" data-blue-envelope>
        <div class="signal-object__paper">SIGNAL / 001</div>
        <div class="signal-object__flap"></div>
        <span>TO / BOOMLEY</span>
      </div>

      <div class="pillar-scene">
        <div class="pillar-shadow"></div>
        <div class="pillar-box" data-pillar-box>
          <div class="pillar-box__cap"></div>
          <div class="pillar-box__neck"></div>
          <div class="pillar-box__body">
            <div class="pillar-box__shine"></div>
            <div class="pillar-box__slot"><span>POST SIGNAL</span></div>
            <div class="pillar-box__plate">
              <strong>BOOMLEY</strong>
              <small>SIGNAL RECEIVER / 001</small>
            </div>
            <div class="pillar-box__door"><span>THE BOX IS OPEN</span></div>
          </div>
          <div class="pillar-box__base"></div>
        </div>
      </div>
    </div>
  </div>
</div>
