---
interface Props { title?: string; description?: string; }
const {title='Boomley — A little more possibility.',description='An independent product company and open workbench. We investigate everyday friction, build thoughtful products, and bring curious people together.'}=Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#090909"/><meta name="description" content={description}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content="https://boomley.netlify.app"/><meta name="twitter:card" content="summary"/><title>{title}</title><link rel="canonical" href="https://boomley.netlify.app"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;450;500;550;600;650;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/></head><body><slot/></body></html>
