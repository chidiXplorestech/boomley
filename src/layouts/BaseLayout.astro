---
interface Props { title?: string; description?: string; }
const {title='Boomley — A little more possibility.',description='An independent product company and open workbench. We investigate everyday friction, build thoughtful products, and bring curious people together.'}=Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://boomley.netlify.app');
---
