---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SignalPost from '../components/SignalPost.astro';
import '../styles/observatory.css';
import '../styles/workbench.css';
const folders = [
 {n:'01',title:'The starting point',tag:'Our story',kind:'story',href:'#story',note:'WHY DOES IT HAVE TO BE THIS HARD?'},
 {n:'02',title:'Product 0001',tag:'Coming soon',kind:'product',href:'#product',note:'0001'},
 {n:'03',title:'Field notes',tag:'Coming soon',kind:'notes',note:'QUESTIONS WORTH KEEPING'},
 {n:'04',title:'The people',tag:'Chidi + Michael',kind:'humans',href:'#people',note:'TWO MINDS. ONE WORKBENCH.'},
 {n:'05',title:'Experiments',tag:'Coming soon',kind:'experiments',note:'WHAT IF…'},
 {n:'06',title:'Signal Mail',tag:'Share a problem',kind:'mail',href:'#signal',note:'DEAR BOOMLEY,'}
];
---
<BaseLayout title="Boomley — Software for everyday problems.">
<a class="skip-link" href="#main">Skip to content</a>
<canvas class="interactive-dots" aria-hidden="true"></canvas>
<dialog class="welcome-dialog" aria-label="Welcome to Boomley"><div class="welcome-top"><span>BOOMLEY / PRODUCT & ENGINEERING</span><button type="button" data-skip-intro>Skip intro <Icon name="arrow-right"/></button></div><div class="welcome-copy"><span class="welcome-kicker">A familiar thought.</span><p>“There has to be<br/><em>a better way.”</em></p><span class="welcome-answer">We build software. That’s where we start.</span></div><span class="welcome-signature"><b class="wordmark-text">boomley</b><i></i></span></dialog>
<div class="film-layer" aria-hidden="true"></div><div class="dust-layer" aria-hidden="true"></div>
<header class="bench-header" id="top"><a class="boomer-logo" href="#top" aria-label="Boomley home"><b class="wordmark-text">boomley</b><span aria-hidden="true"></span></a><nav aria-label="Primary"><a href="#archive">Workbench</a><a href="#people">The people</a><a href="#signal">Signal Mail</a></nav><a class="contact-pill" href="mailto:hello@boomley.com"><Icon name="envelope-simple"/> Email us</a></header>
<div class="bench-layout">
<aside class="bench-sidebar"><div class="sidebar-copy"><span class="index-label">A NOTE FROM THE FOUNDERS</span><h2>That thing <br/>you keep <br/><em>working around?</em></h2><p class="sidebar-lead">Tell us about it.</p><p>We’re Chidi and Michael. We build software for the tasks that take more effort than they should.</p><p>Chidi leads product and research. Michael leads software engineering.</p><a class="email-button" href="#signal"><Icon name="envelope-simple"/> Tell us what’s getting in the way</a><span class="sidebar-caption">It doesn’t need to be a pitch.</span></div><button class="motion-toggle" type="button" aria-pressed="false">Ⅱ Pause motion</button><div class="sidebar-bottom"><span>Two founders. First product in development.</span><a href="/privacy">Privacy</a></div></aside>
<main id="main">
<section class="archive" id="archive"><div class="archive-intro"><span class="archive-tab">BOOMLEY / A TWO-PERSON PRODUCT TEAM</span><h1>We build software<br/><span>for everyday problems.</span></h1><p>Our first product is in development. Here’s who we are, how we work, and where you can share a problem of your own.</p></div>
<div class="folder-grid"><svg class="journey-path" viewBox="0 0 900 600" preserveAspectRatio="none" aria-hidden="true"><path d="M150 150H750Q885 150 885 300T750 450H150"/><circle cx="150" cy="150" r="5"/><circle cx="450" cy="150" r="5"/><circle cx="750" cy="150" r="5"/><circle cx="150" cy="450" r="5"/><circle cx="450" cy="450" r="5"/><circle cx="750" cy="450" r="5"/></svg>
{folders.map(f=><article class:list={['archive-folder',f.kind]}><a class="folder-link" href={f.href || '#soon-'+f.kind}><div class="folder-object" aria-hidden="true"><div class="sheet sheet-back"></div><div class="sheet sheet-middle"></div><div class="sheet sheet-face"><span class="sheet-top"><Icon name={f.kind === "mail" ? "envelope-simple" : f.kind === "humans" ? "users" : "folder"}/> BOOMLEY / {f.n}</span>{f.kind==='humans'? <div class="mini-portraits"><img src="/media/founders/chidi.webp" alt="" width="1000" height="1000"/><img src="/media/founders/michael.webp" alt="" width="1000" height="1000"/></div>:<strong>{f.note}</strong>}<span class="sheet-foot">{f.tag}</span></div><span class="folder-number">{f.n}</span></div><h2>{f.title}</h2><p>{f.tag}</p></a>{!f.href&&<div class="soon-note" id={'soon-'+f.kind}><p>Coming soon</p><a href="#signal">Have a question to contribute?</a></div>}</article>)}
</div><div class="archive-foot"><span>01 — 06 / THE JOURNEY SO FAR</span><span>Building our first product.</span></div></section>
<section id="story" class="bench-story"><span class="index-label">01 / THE STARTING POINT</span><h2>You shouldn’t need<br/>a workaround for <em>everything.</em></h2><div class="story-columns"><p>You copy the same information twice. Lose your place between apps. Spend ten minutes on something that should take two. Eventually, it starts to feel normal.</p><p>That’s the kind of problem we want to work on. We start by understanding what people already do, where they get stuck, and whether software would actually help. Then we build, test, and learn from what happens.</p></div><a class="ink-link" href="#signal">What would you make easier?</a></section>
<section id="product" class="product-note"><div><span class="index-label">02 / PRIVATE BUILD</span><h2>0001<span>Coming soon</span></h2><p>We’re building our first software product. It isn’t ready to try yet. If you’d like to see it when we can share more, leave your email below.</p></div><form class="waitlist" name="product-0001" method="POST" action="/thank-you" data-netlify="true" netlify-honeypot="bot-field" data-waitlist><input type="hidden" name="form-name" value="product-0001"/><p class="honeypot"><label>Leave empty<input name="bot-field"/></label></p><label for="wait-email">Get the first product update.</label><div class="email-row"><input id="wait-email" name="email" type="email" autocomplete="email" required placeholder="Your email address"/><button type="submit">Keep me posted</button></div><p class="form-note">Product updates only. Unsubscribe anytime.</p><p class="form-status" role="status" aria-live="polite"></p></form></section>
    <section id="people" class="section wrap people"><div class="section-top micro"><span>04 / MEET THE FOUNDERS</span><span>PRODUCT & SOFTWARE ENGINEERING</span></div><div class="people-intro"><h2>Chidi and Michael.<br/><em>That’s the team.</em></h2><p>One of us figures out what needs building.<br/>The other works out how to build it.<br/>We work through the decisions together.</p></div><div class="people-grid"><article class="person"><button class="portrait portrait-button" type="button" data-person="chidi" aria-label="Meet Chidi" aria-haspopup="dialog"><img src="/media/founders/chidi.webp" alt="Chidi, co-founder of Boomley" width="1000" height="1000" loading="lazy"/><span class="portrait-tab micro">MEET CHIDI <Icon name="arrow-up-right"/></span></button><div class="person-name"><h3>Chidi</h3><span aria-hidden="true">↗</span></div><span class="micro">PRODUCT & STRATEGY</span><p>Leads research, product direction, and the experience of using what we build.</p></article><article class="person person-michael"><button class="portrait portrait-button" type="button" data-person="michael" aria-label="Meet Michael" aria-haspopup="dialog"><img src="/media/founders/michael.webp" alt="Michael, co-founder of Boomley" width="1000" height="1000" loading="lazy"/><span class="portrait-tab micro">MEET MICHAEL <Icon name="arrow-up-right"/></span></button><div class="person-name"><h3>Michael</h3><span aria-hidden="true">↗</span></div><span class="micro">SOFTWARE ENGINEERING</span><p>Leads development, from the systems behind the product to the details you interact with.</p></article></div></section>

<dialog class="founder-dialog" aria-labelledby="founder-name"><button class="founder-close" type="button" aria-label="Close profile"><Icon name="x"/></button><img class="founder-photo" src="/media/founders/chidi.webp" width="1000" height="1000" alt=""/><div class="founder-info"><span class="index-label" data-founder-role></span><h2 id="founder-name"></h2><p data-founder-copy></p><a class="email-button" href="#signal" data-founder-mail><Icon name="envelope-simple"/> Send us a note</a><div class="founder-switch"><button type="button" data-founder-prev aria-label="Previous founder"><Icon name="arrow-left"/></button><button type="button" data-founder-next aria-label="Next founder"><Icon name="arrow-right"/></button></div></div></dialog>
<SignalPost/>
<footer class="bench-footer"><a class="boomer-logo" href="#top" aria-label="Boomley, back to top"><b class="wordmark-text">boomley</b><span aria-hidden="true"></span></a><p>Got a question? Write to us.</p><a class="email-button" href="mailto:hello@boomley.com"><Icon name="envelope-simple"/> Email Chidi & Michael</a><span class="footer-email">hello@boomley.com</span><div><span>© {new Date().getFullYear()} BOOMLEY</span><a href="/privacy">Privacy</a><a href="#archive">Back to the folders ↑</a></div></footer>
</main></div><script>import '../scripts/observatory.ts'; import '../scripts/workbench-motion.ts';</script>
</BaseLayout>
