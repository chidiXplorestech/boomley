---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---
<BaseLayout>
  <div class="cursor" aria-hidden="true"><span></span></div>

  <header class="site-header" data-header>
    <a class="brand" href="#top" aria-label="Boomley home">BOOMLEY®</a>
    <nav class="nav" aria-label="Primary navigation">
      <a href="#signal-story">Signal</a>
      <a href="#founders">People</a>
      <a href="#product">Product / 001</a>
      <a href="#postbox">Send a signal</a>
    </nav>
    <span class="header-status">TEAM / 02 · STATUS / BUILDING</span>
  </header>

  <main id="top">
    <section class="hero section section--paper" aria-labelledby="hero-title">
      <div class="hero-grid">
        <div class="hero-copy">
          <div class="system-row" data-reveal>
            <span>BOOMLEY / TRANSMISSION 001</span>
            <span>PRODUCT × ENGINEERING</span>
          </div>
          <h1 id="hero-title" class="hero-title" data-split>
            BUILD THE THINGS<br />
            PEOPLE <em>WISH</em><br />
            EXISTED.
          </h1>
          <div class="hero-summary" data-reveal>
            <p>Boomley is two people building software around the problems people should not still have.</p>
            <div class="hero-facts" aria-label="Company status">
              <span><b>02</b> people</span>
              <span><b>01</b> product</span>
              <span><b>OPEN</b> signal box</span>
            </div>
          </div>
          <div class="hero-actions" data-reveal>
            <a class="button button--ink" href="#product">SEE WHAT WE'RE BUILDING <span>↓</span></a>
            <a class="button button--ghost" href="#postbox">SEND A SIGNAL <span>↗</span></a>
          </div>
        </div>

        <div class="hero-collage" data-reveal>
          <figure class="portrait portrait--hero portrait--chidi">
            <div class="sprite portrait-image sprite-chidi" role="img" aria-label="Boomley founder portrait"></div>
            <figcaption><span>PRODUCT</span><small>01 / QUESTIONS EVERYTHING</small></figcaption>
          </figure>
          <figure class="portrait portrait--hero portrait--michael">
            <div class="sprite portrait-image sprite-michael" role="img" aria-label="Boomley founder portrait"></div>
            <figcaption><span>ENGINEERING</span><small>02 / MAKES IT REAL</small></figcaption>
          </figure>
          <div class="hero-note note-a">CURRENTLY / RESEARCH → BUILD</div>
          <div class="hero-note note-b">MODERN-DAY PROBLEMS REQUIRE MODERN SOLUTIONS.</div>
          <div class="hero-cross" aria-hidden="true">+</div>
        </div>
      </div>

      <div class="ascii-ribbon" aria-hidden="true">
        <div class="ascii-ribbon__track">01001 SIGNAL 01100 BUILD 10010 NOTICE 00101 QUESTION 11010 LISTEN 00110 DESIGN 10110 TEST 00101 SHIP 01001 SIGNAL 01100 BUILD 10010 NOTICE 00101 QUESTION 11010 LISTEN 00110 DESIGN 10110 TEST 00101 SHIP</div>
      </div>
    </section>

    <section id="signal-story" class="section section--blue signal-story">
      <div class="section-kicker">01 / THE SIGNAL</div>
      <div class="signal-layout">
        <div class="signal-title-wrap">
          <span class="tiny-label">SOMETHING FEELS OFF.</span>
          <h2 class="poster-title" data-reveal>THAT'S<br />NOT NOISE.<br /><em>THAT'S A SIGNAL.</em></h2>
        </div>
        <div class="signal-copy" data-reveal>
          <p>People complain. They create workarounds. They learn to live with software that makes simple things harder.</p>
          <p>We look for the patterns underneath that friction — then ask a harder question:</p>
          <blockquote>Does this deserve a better product?</blockquote>
        </div>
      </div>
      <div class="signal-cards" data-reveal>
        <article><span>01</span><h3>NOTICE</h3><p>Find the repeated pain.</p></article>
        <article><span>02</span><h3>UNDERSTAND</h3><p>Study the people and the cost.</p></article>
        <article><span>03</span><h3>BUILD</h3><p>Make the answer tangible.</p></article>
        <article><span>04</span><h3>LISTEN AGAIN</h3><p>Let reality sharpen the product.</p></article>
      </div>
      <pre class="ascii-wave" aria-hidden="true">.............................................:::::::::::::::;;;;;;;;;;;;;;;iiiiiiiiiiiiiirrrrrrrrrrrrrrssssssssssssssXXXXXXXXXXXXXXAAAAAAA2222222555555533333333333333hhhhhhhhhhhMMMMMMMMMHHHHHHHHHGGGGGGGGGSSSSSSS#######9999BBBB&&&&@@@@
.................................::::::::::::;;;;;;;;;;;;iiiiiiiiirrrrrrrrrrrrsssssssssXXXXXXXXAAAAAA222222555555333333hhhhhhhhMMMMMMMHHHHHGGGGGSSSSS#####99BBB&&@@@
.....................::::::::::::;;;;;;;;;;iiiiiiiirrrrrrrrrrssssssssXXXXXAAAAA22222555533333hhhhhMMMMMHHHHGGGGSSSS###999BBB&&@@@
.............::::::::::::;;;;;;;;iiiiiiirrrrrrrrssssssXXXXXAAAA222255553333hhhhMMMMHHHGGGSSS###99BB&&@@
......:::::::::::;;;;;;;iiiiiirrrrrrsssssXXXXAAA222555333hhhMMMHHHGGSS##99BB&&@@</pre>
    </section>

    <section id="founders" class="section section--ink founders">
      <div class="section-kicker section-kicker--light">02 / TWO PEOPLE / FOR NOW</div>
      <div class="founders-head">
        <h2 class="display-serif" data-reveal>Product asks <em>why.</em><br />Engineering asks <em>how.</em></h2>
        <p data-reveal>Boomley happens somewhere between those two questions.</p>
      </div>

      <div class="founder-grid">
        <article class="founder-card" data-founder-card tabindex="0">
          <div class="founder-media">
            <div class="founder-photo sprite sprite-chidi" role="img" aria-label="Chidi, Product Management"></div>
            <div class="founder-ascii sprite sprite-chidi-ascii" role="img" aria-label="ASCII interpretation of Chidi's portrait"></div>
            <div class="founder-hover-copy"><span>BOOMLEY / 01</span><b>PRODUCT MANAGEMENT</b><small>X / HANDLE TO ADD</small></div>
          </div>
          <div class="founder-meta"><span>01</span><h3>CHIDI</h3><p>Product Management · Strategy · Research · Experience</p></div>
        </article>

        <article class="founder-card" data-founder-card tabindex="0">
          <div class="founder-media">
            <div class="founder-photo sprite sprite-michael" role="img" aria-label="Michael, Software Engineering"></div>
            <div class="founder-ascii sprite sprite-michael-ascii" role="img" aria-label="ASCII interpretation of Michael's portrait"></div>
            <div class="founder-hover-copy"><span>BOOMLEY / 02</span><b>SOFTWARE ENGINEERING</b><small>X / HANDLE TO ADD</small></div>
          </div>
          <div class="founder-meta"><span>02</span><h3>MICHAEL</h3><p>Software Engineering · Systems · Architecture · Build</p></div>
        </article>
      </div>

      <div class="founder-line" data-reveal>
        <span>ONE COMPANY.</span><span>TWO DISCIPLINES.</span><span>A LOT LEFT TO FIGURE OUT.</span><strong>PERFECT.</strong>
      </div>
    </section>

    <section id="product" class="section section--paper product-section">
      <div class="section-kicker">03 / PRODUCT / 001</div>
      <div class="product-hero">
        <div class="product-copy">
          <span class="status-pill">IN DEVELOPMENT</span>
          <h2 class="product-name" data-reveal>DECLUTTER.</h2>
          <p class="product-sub" data-reveal>A calmer space for people trying to do meaningful work without being dragged sideways by everything else.</p>
        </div>
        <div class="product-teaser" data-product-teaser>
          <div class="teaser-grid" aria-hidden="true"></div>
          <div class="teaser-scan" aria-hidden="true"></div>
          <div class="teaser-word">LOCK<br /><em>IN.</em></div>
          <span class="teaser-label">PRIVATE BUILD / SIGNAL 001</span>
        </div>
      </div>

      <div class="roadmap" data-roadmap>
        <article class="done"><span>01</span><h3>RESEARCH</h3><small>COMPLETE</small></article>
        <article class="done"><span>02</span><h3>DOCUMENTATION</h3><small>COMPLETE</small></article>
        <article class="active"><span>03</span><h3>EXPERIENCE + SYSTEMS</h3><small>YOU ARE HERE</small></article>
        <article><span>04</span><h3>BUILD</h3><small>NEXT</small></article>
        <article><span>05</span><h3>PRIVATE TESTING</h3><small>QUEUED</small></article>
        <article><span>06</span><h3>FIRST RELEASE</h3><small>WHEN READY</small></article>
      </div>

      <div class="early-access" data-reveal>
        <div>
          <span class="tiny-label">EARLY ACCESS / PRODUCT 001</span>
          <h3>THIS ISN'T<br />FOR EVERYONE.</h3>
          <p>Good. Declutter is being built for people willing to take their own intentions seriously.</p>
        </div>
        <form class="waitlist-form" name="declutter-waitlist" method="POST" data-netlify="true" netlify-honeypot="bot-field" data-netlify-form>
          <input type="hidden" name="form-name" value="declutter-waitlist" />
          <p class="honeypot"><label>Do not fill this out: <input name="bot-field" /></label></p>
          <label for="waitlist-email">Coming soon — be among the first to experience real lock-in power.</label>
          <div class="input-row">
            <input id="waitlist-email" type="email" name="email" placeholder="ENTER EMAIL" autocomplete="email" required />
            <button type="submit">I'M SERIOUS →</button>
          </div>
          <p class="form-status" data-form-status aria-live="polite"></p>
        </form>
      </div>
    </section>

    <section id="postbox" class="section section--mist postbox-section">
      <div class="section-kicker">04 / SEND A SIGNAL</div>
      <div class="postbox-head">
        <h2 class="display-serif" data-reveal>What have <em>you</em><br />noticed?</h2>
        <div class="instructions" data-reveal>
          <p>Tell us about a problem, frustration or experience that should not still be this difficult.</p>
          <strong>Don't pitch us an app. Tell us what's broken.</strong>
        </div>
      </div>

      <div class="postbox-workspace" data-signal-stage>
        <div class="mail-instructions" aria-live="polite">
          <span class="step is-active" data-step="1"><b>01</b> WRITE YOUR SIGNAL</span>
          <span class="step" data-step="2"><b>02</b> WRAP THE LETTER</span>
          <span class="step" data-step="3"><b>03</b> POST IT</span>
        </div>

        <form class="letter" name="boomley-signal" method="POST" data-netlify="true" netlify-honeypot="bot-field" data-signal-form>
          <input type="hidden" name="form-name" value="boomley-signal" />
          <p class="honeypot"><label>Do not fill this out: <input name="bot-field" /></label></p>
          <div class="letter-top"><span>BOOMLEY SIGNAL FORM / 001</span><span>THE BOX IS OPEN</span></div>
          <h3>WHAT'S BOTHERING YOU?</h3>
          <p class="letter-prompt">Write the problem, not the product you think we should build.</p>
          <label>THE PROBLEM
            <textarea name="friction" rows="4" required placeholder="It shouldn't still be this difficult to..."></textarea>
          </label>
          <label>WHO DEALS WITH THIS?
            <input name="who" type="text" required placeholder="People who..." />
          </label>
          <label>WHAT WOULD CHANGE IF IT WAS FIXED?
            <textarea name="change" rows="2" required placeholder="It would make it easier to..."></textarea>
          </label>
          <label>YOUR EMAIL
            <input name="email" type="email" required autocomplete="email" placeholder="you@example.com" />
          </label>
          <div class="letter-actions">
            <button class="button button--blue" type="button" data-wrap-button>WRAP IT →</button>
            <button class="button button--red" type="submit" data-post-button disabled>POST IT →</button>
          </div>
          <p class="form-status" data-signal-status aria-live="polite"></p>
        </form>

        <div class="envelope-stage" aria-hidden="true">
          <div class="blue-envelope" data-blue-envelope>
            <div class="blue-envelope__paper">SIGNAL / 001</div>
            <div class="blue-envelope__flap"></div>
            <span>TO / BOOMLEY</span>
          </div>
        </div>

        <div class="pillar-wrap">
          <div class="pillar-box" data-pillar-box aria-label="Boomley Signal Box">
            <div class="pillar-cap"></div>
            <div class="pillar-neck"></div>
            <div class="pillar-body">
              <div class="pillar-highlight"></div>
              <div class="pillar-slot"><span>POST SIGNAL</span></div>
              <div class="pillar-plaque"><b>BOOMLEY</b><small>SIGNAL BOX / 001</small></div>
              <div class="pillar-door"><span>THE BOX IS OPEN</span></div>
            </div>
            <div class="pillar-base"></div>
          </div>
          <p class="pillar-caption">A British pillar-box-inspired Boomley object. No pitch deck required. Just the problem.</p>
        </div>
      </div>
    </section>

    <section class="section section--ink finale">
      <pre class="final-ascii" aria-hidden="true">B O O M L E Y    /    S I G N A L    R E C E I V E R
01010011 01001001 01000111 01001110 01000001 01001100
PEOPLE  ×  PROBLEMS  ×  PRODUCTS
01000010 01010101 01001001 01001100 01000100
THE BOX IS OPEN.</pre>
      <div class="final-copy">
        <span>END OF TRANSMISSION?</span>
        <h2 class="display-serif" data-reveal>Not even<br /><em>close.</em></h2>
        <p data-reveal>Declutter is the first thing we're building. It won't be the last.</p>
      </div>
      <footer class="footer">
        <span>BOOMLEY® © 2026</span>
        <span>PRODUCT × ENGINEERING</span>
        <a href="#postbox">SEND SOMETHING ↑</a>
      </footer>
    </section>
  </main>

  <script>
    import '../scripts/home.ts';
  </script>
</BaseLayout>
