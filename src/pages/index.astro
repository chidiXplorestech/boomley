---
import BaseLayout from '../layouts/BaseLayout.astro';
import FounderPortrait from '../components/FounderPortrait.astro';
import SignalBox from '../components/SignalBox.astro';
import '../styles/global.css';
---
<BaseLayout>
  <div class="cursor" aria-hidden="true"><span></span></div>
  <div class="signal-traveller" data-signal-traveller aria-hidden="true">
    <span class="signal-traveller__paper"></span>
    <span class="signal-traveller__flap"></span>
  </div>

  <header class="site-header" data-header>
    <a class="brand" href="#top" aria-label="Boomley home">BOOMLEY®</a>
    <nav class="nav" aria-label="Primary navigation">
      <a href="#signal">Signal</a>
      <a href="#people">People</a>
      <a href="#product">Product / 001</a>
      <a href="#postbox">Send a signal</a>
    </nav>
    <span class="header-status">02 PEOPLE · 01 PRODUCT · BUILDING</span>
  </header>

  <main id="top">
    <section class="cover" aria-labelledby="hero-title">
      <div class="cover__frame">
        <div class="cover__meta" data-reveal>
          <span>BOOMLEY / ISSUE 001</span>
          <span>PRODUCT × ENGINEERING</span>
          <span>2026 / WORK IN PROGRESS</span>
        </div>

        <div class="cover__content">
          <div class="cover__copy">
            <p class="cover__standfirst" data-reveal>Two people building software around the problems people should not still have.</p>
            <h1 id="hero-title" class="cover__title" data-split>
              BUILD THE THINGS<br />
              PEOPLE <em>WISH</em><br />
              EXISTED.
            </h1>
          </div>

          <div class="cover__portrait-stage" data-reveal>
            <figure class="cover-portrait cover-portrait--a">
              <div class="sprite sprite-chidi" role="img" aria-label="Chidi, Boomley Product Management"></div>
              <figcaption>01 / PRODUCT</figcaption>
            </figure>
            <figure class="cover-portrait cover-portrait--b">
              <div class="sprite sprite-michael" role="img" aria-label="Michael, Boomley Software Engineering"></div>
              <figcaption>02 / ENGINEERING</figcaption>
            </figure>

            <div class="cover__annotation cover__annotation--a">WHY IS THIS<br />STILL THIS<br />DIFFICULT?</div>
            <div class="cover__annotation cover__annotation--b">CURRENTLY<br />RESEARCH → BUILD</div>
            <div class="cover__mark">✦</div>
          </div>
        </div>

        <div class="cover__bottom" data-reveal>
          <p>Modern-day problems require modern solutions.</p>
          <div class="cover__facts" aria-label="Current company facts">
            <span><b>02</b> PEOPLE</span>
            <span><b>01</b> PRODUCT</span>
            <span><b>OPEN</b> SIGNAL BOX</span>
          </div>
          <a class="text-link" href="#signal">ENTER THE SIGNAL ↓</a>
        </div>
      </div>
    </section>

    <section id="signal" class="noise-chapter" data-noise-chapter>
      <div class="noise-chapter__sticky">
        <div class="noise-chapter__counter">ACT 01 / WHAT WE NOTICE</div>

        <div class="noise-fragments" aria-hidden="true">
          <span data-fragment style="--x:5%;--y:17%;--r:-7deg">WHY DOES THIS TAKE SEVEN STEPS?</span>
          <span data-fragment style="--x:58%;--y:14%;--r:4deg">I NEED THREE APPS FOR THIS.</span>
          <span data-fragment style="--x:21%;--y:64%;--r:2deg">SURELY THIS CAN BE SIMPLER.</span>
          <span data-fragment style="--x:67%;--y:71%;--r:-5deg">WHY HAVE WE ACCEPTED THIS?</span>
          <span data-fragment style="--x:42%;--y:39%;--r:8deg">I WISH SOMETHING EXISTED THAT…</span>
          <span data-fragment class="noise-fragments__ascii">+_+_+ SIGNAL? 01010011 / FRICTION / 01110 / NOISE / 00101 / NOTICE / 11001</span>
        </div>

        <div class="noise-chapter__reveal">
          <span>WHEN A FRUSTRATION KEEPS REPEATING,</span>
          <h2>THAT'S<br /><em>A SIGNAL.</em></h2>
          <p>Boomley looks for the patterns people learn to live with — then asks whether the problem deserves a better product.</p>
        </div>

        <div class="signal-process">
          <span>NOTICE</span><i>→</i><span>UNDERSTAND</span><i>→</i><span>BUILD</span><i>→</i><span>LISTEN AGAIN</span>
        </div>
      </div>
    </section>

    <section id="people" class="people-spread">
      <div class="people-spread__intro">
        <span class="chapter-label">ACT 02 / WHO'S BUILDING IT</span>
        <h2 data-reveal>TWO PEOPLE.<br /><em>FOR NOW.</em></h2>
        <p data-reveal>Product asks <strong>why.</strong> Engineering asks <strong>how.</strong> Boomley happens somewhere between those two questions.</p>
      </div>

      <div class="people-spread__grid">
        <FounderPortrait
          id="01"
          name="CHIDI"
          role="PRODUCT MANAGEMENT"
          descriptor="Strategy · Research · Product Direction · Experience"
          spriteClass="sprite-chidi"
          asciiQuadrant="chidi"
        />
        <FounderPortrait
          id="02"
          name="MICHAEL"
          role="SOFTWARE ENGINEERING"
          descriptor="Systems · Architecture · Engineering · Build"
          spriteClass="sprite-michael"
          asciiQuadrant="michael"
        />
      </div>

      <div class="people-spread__footer" data-reveal>
        <span>ONE COMPANY.</span>
        <span>TWO DISCIPLINES.</span>
        <span>A LOT LEFT TO FIGURE OUT.</span>
        <strong>PERFECT.</strong>
      </div>
    </section>

    <section id="product" class="product-documentary">
      <div class="product-documentary__intro">
        <span class="chapter-label">ACT 03 / CURRENTLY BUILDING</span>
        <p class="product-documentary__whisper" data-reveal>WE NOTICED SOMETHING.</p>
        <h2 data-reveal>SO WE KEPT<br /><em>PULLING AT IT.</em></h2>
      </div>

      <div class="evidence-stack" data-evidence-stack>
        <article class="evidence evidence--research">
          <span class="evidence__id">RESEARCH / 01</span>
          <div class="evidence__scribble">focus ≠ another<br />thing to manage</div>
          <p>Modern productivity keeps fragmenting attention across more tools, more tabs and more sideways pulls.</p>
        </article>

        <article class="evidence evidence--document">
          <span class="evidence__id">DOCUMENT / 02</span>
          <div class="evidence__diagram">
            <span>INTENTION</span><i>→</i><span>PROTECTED SPACE</span><i>→</i><span>FOLLOW THROUGH</span>
          </div>
          <p>We started turning the philosophy into rules, behaviours and product systems.</p>
        </article>

        <article class="evidence evidence--interface">
          <span class="evidence__id">EXPERIENCE / 03</span>
          <div class="evidence__screen">
            <span>STUDY SPACE</span>
            <strong>ONE THING.<br />LONG ENOUGH<br />TO FINISH IT.</strong>
            <small>PRIVATE PRODUCT MEDIA SLOT</small>
          </div>
        </article>
      </div>

      <div class="declutter-reveal">
        <span class="declutter-reveal__index">BOOMLEY PRODUCT / 001</span>
        <h2 data-reveal>DECLUTTER.</h2>
        <p data-reveal>A modern focus and study environment designed to reduce fragmentation and protect the intention you arrived with.</p>
      </div>

      <div class="build-line" data-build-line>
        <div class="build-line__rail"><span data-build-progress></span></div>
        <article class="is-complete"><b>01</b><h3>RESEARCH</h3><small>COMPLETE</small></article>
        <article class="is-complete"><b>02</b><h3>DOCUMENTATION</h3><small>COMPLETE</small></article>
        <article class="is-current"><b>03</b><h3>EXPERIENCE + SYSTEMS</h3><small>YOU ARE HERE</small></article>
        <article><b>04</b><h3>BUILD</h3><small>NEXT</small></article>
        <article><b>05</b><h3>PRIVATE TESTING</h3><small>QUEUED</small></article>
        <article><b>06</b><h3>FIRST RELEASE</h3><small>WHEN READY</small></article>
      </div>

      <div class="early-access" data-reveal>
        <div class="early-access__copy">
          <span>EARLY ACCESS / PRODUCT 001</span>
          <h3>THIS ISN'T<br />FOR EVERYONE.</h3>
          <p>Good. Declutter is being built for people willing to take their own intentions seriously.</p>
        </div>
        <form class="waitlist-form" name="declutter-waitlist" method="POST" data-netlify="true" netlify-honeypot="bot-field" data-netlify-form>
          <input type="hidden" name="form-name" value="declutter-waitlist" />
          <p class="honeypot"><label>Do not fill this out: <input name="bot-field" /></label></p>
          <label for="waitlist-email">Coming soon — be among the first to experience real lock-in power.</label>
          <div class="waitlist-form__row">
            <input id="waitlist-email" type="email" name="email" placeholder="ENTER EMAIL" autocomplete="email" required />
            <button type="submit">I'M SERIOUS ↗</button>
          </div>
          <p class="form-status" data-form-status aria-live="polite"></p>
        </form>
      </div>
    </section>

    <section id="postbox" class="mailroom">
      <div class="mailroom__intro">
        <span class="chapter-label">ACT 04 / SEND SOMETHING</span>
        <h2 data-reveal>PRODUCT 001 CAME<br />FROM <em>A SIGNAL.</em></h2>
        <p data-reveal>Product 002 might come from yours. You do not need an app idea. You only need to have noticed something that should work better.</p>
      </div>

      <SignalBox />
    </section>

    <section class="finale">
      <div class="finale__ascii" aria-hidden="true">
        <span>01010011 01001001 01000111 01001110 01000001 01001100</span>
        <span>PEOPLE / PROBLEMS / PRODUCTS / BETTER</span>
        <span>THE BOX IS OPEN / THE STORY IS NOT FINISHED</span>
      </div>
      <div class="finale__copy">
        <span>ACT 05 / TO BE CONTINUED</span>
        <h2 data-reveal>NOT EVEN<br /><em>CLOSE.</em></h2>
        <p data-reveal>Declutter is the first thing we're building. It won't be the last.</p>
      </div>
      <footer class="footer">
        <span>BOOMLEY® © 2026</span>
        <span>PRODUCT × ENGINEERING</span>
        <a href="#postbox">THE SIGNAL BOX IS OPEN ↑</a>
      </footer>
    </section>
  </main>

  <script>
    import '../scripts/home.ts';
  </script>
</BaseLayout>
